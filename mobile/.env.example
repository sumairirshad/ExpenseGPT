# The Expense GPT web server's base URL (the Next.js app in ../web), reachable
# from wherever this app runs. Copy this file to .env and restart `expo start`.
#
# - Physical phone via Expo Go: your computer's LAN IP, e.g. http://192.168.1.23:3000
# - Android emulator:           http://10.0.2.2:3000
# - iOS simulator:               http://localhost:3000
# - `expo start --web`:          http://localhost:3000
#
# The web server must be started with a host it will actually listen on for
# LAN/emulator access, e.g. `npm run dev -- -H 0.0.0.0` in web/.
EXPO_PUBLIC_API_URL=http://localhost:3000
