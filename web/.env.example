# Postgres connection (docker compose up -d starts one matching this URL)
DATABASE_URL=postgres://expensegpt:expensegpt@localhost:5432/expensegpt

# Optional. Without at least one of these, Expense GPT uses its built-in
# rule-based parser. Set either or both; Claude is tried first by default.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider to try first when both keys are set. "claude" (default) or "openai".
# AI_PROVIDER=claude

# Optional per-provider model overrides.
# EXPENSEGPT_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5.1
