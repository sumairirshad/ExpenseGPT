# Postgres connection (docker compose up -d starts one matching this URL)
DATABASE_URL=postgres://expensegpt:expensegpt@localhost:5432/expensegpt

# Optional. Without it, Expense GPT uses its built-in rule-based parser.
ANTHROPIC_API_KEY=

# Optional model override for message extraction.
# EXPENSEGPT_MODEL=claude-opus-5-5
